{
  "name": "complex-ai",
  "version": "1.0.0",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.complex.ai",
    "productName": "Complex",
    "mac": {
      "icon": "src/assets/icons/mac/icon.icns",
      "category": "public.app-category.productivity"
    },
    "win": {
      "icon": "src/assets/ComplexIcon.png"
    },
    "files": [
      "src/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    }
  },
  "dependencies": {
    "electron-store": "^8.2.0"
  },
  "devDependencies": {
    "electron": "^42.3.3",
    "electron-builder": "^26.15.0"
  }
}
